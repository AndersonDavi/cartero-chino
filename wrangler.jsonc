// Publicación en Cloudflare: la app es un sitio estático (lo que genera `npm run build` en dist/).
// Publicar: npm run build && npx wrangler deploy
{
  "name": "cartero-chino",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
